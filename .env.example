# Server-only variables for the Vercel functions in api/ (set them in the Vercel
# dashboard for production; `vercel env pull` writes them to .env.local for `vercel dev`).

# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Class hub sign-in and activity reports (see api/_lib/hub.ts)
HUB_URL=https://preview.cbs-tech-strategy.com
# The hub's public key (base64 of the PEM, or the PEM itself)
HUB_JWT_PUBLIC_KEY=
HUB_COOKIE_NAME=cts_preview_session
HUB_APP_SLUG=pollanywhere
# This app's key (hub admin -> App keys), used to report activity
HUB_APP_KEY=
# Optional: only while the hub's deployment sits behind Vercel Authentication
HUB_PROTECTION_BYPASS=
# Vercel Cron sends it to the daily sweep (/api/hub/sweep)
CRON_SECRET=

# Build-time variables for the frontend (Vite): the page sends signed-out visitors to the hub
VITE_HUB_URL=https://preview.cbs-tech-strategy.com
VITE_HUB_APP_SLUG=pollanywhere
