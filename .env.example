# Server-only variables for the Vercel functions in api/ (set them in the Vercel
# dashboard for production; `vercel env pull` writes them to .env.local for `vercel dev`).

# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Google sign-in for admins) — Neon Console → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# 32+ random characters, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=

# Password for the superadmin's password login (the "Password" tab on /admin)
SUPERADMIN_PASSWORD=
